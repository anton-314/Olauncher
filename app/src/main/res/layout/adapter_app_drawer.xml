<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <!-- A 28dp column for the first letter, then the name -->
    <LinearLayout
        android:id="@+id/appRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/home_gutter"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/appLetter"
                style="@style/TextMonoSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="10dp"
                android:textColor="?attr/textFaintColor"
                tools:ignore="RtlSymmetry"
                tools:text="A" />

            <!-- An app of another profile, e.g. the work profile -->
            <ImageView
                android:id="@+id/otherProfileIndicator"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rounded"
                app:tint="?attr/primaryColor" />
        </FrameLayout>

        <TextView
            android:id="@+id/appTitle"
            style="@style/TextDrawer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:paddingEnd="@dimen/home_gutter"
            android:text="@string/app"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <!-- Long press menu; back or a tap elsewhere closes it -->
    <LinearLayout
        android:id="@+id/appHideLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="2dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/appMenuTitle"
            style="@style/TextDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="7dp"
            android:paddingBottom="12dp"
            android:textColor="?attr/primaryColor"
            tools:text="Kamera" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <TextView
                android:id="@+id/appRename"
                style="@style/Chip"
                android:text="@string/rename" />

            <TextView
                android:id="@+id/appHide"
                style="@style/Chip"
                android:text="@string/hide" />

            <TextView
                android:id="@+id/appPause"
                style="@style/Chip"
                android:text="@string/pause" />

            <TextView
                android:id="@+id/appInfo"
                style="@style/Chip"
                android:text="@string/info" />

            <TextView
                android:id="@+id/appDelete"
                style="@style/Chip"
                android:text="@string/delete"
                android:textColor="?attr/textMutedColor" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- Rename, in the same card -->
    <LinearLayout
        android:id="@+id/renameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="2dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etAppRename"
            style="@style/TextDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@null"
            android:inputType="textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:paddingBottom="10dp"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/textHintColor" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/searchLineActiveColor" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <TextView
                android:id="@+id/tvSaveRename"
                style="@style/Chip"
                android:text="@string/save" />

            <TextView
                android:id="@+id/appRenameClose"
                style="@style/Chip"
                android:text="@string/cancel" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

</FrameLayout>
