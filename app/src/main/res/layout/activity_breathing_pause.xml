<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <!-- Grows over the inhale and shrinks over the exhale of one breath -->
        <View
            android:id="@+id/breathCircle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/breathing_circle" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:includeFontPadding="false"
            android:text="@string/breathing_pause"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.7"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/primaryColor"
            tools:text="@string/breathing_pause_message" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tvClose"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:includeFontPadding="false"
            android:padding="12dp"
            android:text="@string/close"
            android:textColor="?attr/primaryColor" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvOpen"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:includeFontPadding="false"
            android:padding="12dp"
            android:textColor="?attr/primaryColor"
            android:textSize="18sp"
            tools:text="@string/open_app" />
    </LinearLayout>

</FrameLayout>
