<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryInverseColor"
    android:fitsSystemWindows="true">

    <!-- Countdown, shown when no Anki card is due -->
    <FrameLayout
        android:id="@+id/pauseLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp">

                <!-- Grows over the inhale and shrinks over the exhale of one breath -->
                <View
                    android:id="@+id/breathCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/breathing_circle" />

                <!-- Breathe in, breathe out; follows the circle -->
                <TextView
                    android:id="@+id/tvBreath"
                    style="@style/TextMono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.08"
                    android:textColor="?attr/textMutedColor"
                    android:visibility="invisible"
                    tools:text="@string/inhale"
                    tools:visibility="visible" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPausedApp"
                style="@style/TextMonoSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:letterSpacing="0.08"
                android:textColor="?attr/textLabelColor"
                tools:text="Instagram · pausiert" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/breathing_pause" />

            <TextView
                android:id="@+id/tvMessage"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="?attr/textBodyColor"
                app:lineHeight="24sp"
                tools:text="@string/breathing_pause_message" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/settings_gutter"
            android:layout_marginBottom="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClose"
                style="@style/TextButton"
                android:text="@string/close" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvOpen"
                style="@style/OutlineButton"
                tools:text="@string/open_app" />
        </LinearLayout>
    </FrameLayout>

    <!-- Anki review: the card fills the screen, the answer buttons sit at the bottom -->
    <LinearLayout
        android:id="@+id/ankiLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/settings_gutter"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvAnkiProgress"
                style="@style/TextMono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="14dp"
                tools:text="1 / 2" />

            <TextView
                android:id="@+id/tvAnkiClose"
                style="@style/TextButton"
                android:layout_marginEnd="-12dp"
                android:text="@string/close" />
        </LinearLayout>

        <!-- The WebView is added in code, only when there are cards to show -->
        <FrameLayout
            android:id="@+id/ankiCardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvShowAnswer"
                style="@style/OutlineButton"
                android:layout_gravity="center"
                android:text="@string/show_answer" />

            <LinearLayout
                android:id="@+id/answerButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="invisible"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/answerAgain"
                    style="@style/AnkiAnswerButton"
                    tools:text="@string/anki_again" />

                <TextView
                    android:id="@+id/answerHard"
                    style="@style/AnkiAnswerButton"
                    tools:text="@string/anki_hard" />

                <TextView
                    android:id="@+id/answerGood"
                    style="@style/AnkiAnswerButton"
                    tools:text="@string/anki_good" />

                <TextView
                    android:id="@+id/answerEasy"
                    style="@style/AnkiAnswerButton"
                    tools:text="@string/anki_easy" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
