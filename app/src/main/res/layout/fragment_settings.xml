<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/settingsBackgroundColor">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fadingEdgeLength="48dp"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/screen_inset"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="64dp"
            android:paddingBottom="64dp">

            <!-- Title, a long press opens Olauncher's app info; hidden apps on the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_gutter"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/settingsTitle"
                    style="@style/TextTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings" />

                <TextView
                    android:id="@+id/olauncherHiddenApps"
                    style="@style/TextMonoSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-8dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/hidden_apps_short"
                    android:textColor="?attr/textLabelColor" />
            </LinearLayout>

            <TextView
                android:id="@+id/setLauncher"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/settings_gutter"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:paddingVertical="8dp"
                android:text="@string/set_as_default_launcher"
                android:textColor="?attr/primaryColor"
                android:textSize="14sp" />

            <!-- Home screen -->
            <TextView
                style="@style/SettingsSection"
                android:layout_marginTop="24dp"
                android:text="@string/home_screen" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout
                    android:id="@+id/homeAppsNumRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/apps_on_home_screen" />

                    <TextView
                        android:id="@+id/homeAppsNum"
                        style="@style/SettingsRowValue"
                        tools:text="@string/_6" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dateTimeRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/show_date_time" />

                    <TextView
                        android:id="@+id/dateTime"
                        style="@style/SettingsRowValue"
                        android:text="@string/on" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/alignmentRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/home_layout_alignment" />

                    <TextView
                        android:id="@+id/alignment"
                        style="@style/SettingsRowValue"
                        android:text="@string/left" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/screenTimeLayout"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/screen_time" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/screenTimeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Appearance -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/appearance" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout
                    android:id="@+id/appThemeRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/theme_mode" />

                    <TextView
                        android:id="@+id/appThemeText"
                        style="@style/SettingsRowValue"
                        android:text="@string/dark" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/textSizeRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/text_size" />

                    <TextView
                        android:id="@+id/textSizeValue"
                        style="@style/SettingsRowValue"
                        tools:text="100%" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boldFontRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/bold_font" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/boldFontSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/autoShowKeyboardRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/auto_show_keyboard" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/autoShowKeyboardSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Tapping the label opens the wallpaper source, a long press removes the wallpaper -->
                <LinearLayout
                    android:id="@+id/dailyWallpaperRow"
                    style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/dailyWallpaperUrl"
                        style="@style/SettingsRowLabel"
                        android:layout_width="wrap_content"
                        android:layout_weight="0"
                        android:text="@string/daily_wallpaper_update" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/dailyWallpaperSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statusBarRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/notification_bar" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/statusBarSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gestures: a long press on a swipe row turns the gesture on or off -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/gestures" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout
                    android:id="@+id/swipeLeftRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/swipe_left_app" />

                    <TextView
                        android:id="@+id/swipeLeftApp"
                        style="@style/SettingsRowValue"
                        android:maxWidth="150dp"
                        tools:text="@string/camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/swipeRightRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/swipe_right_app" />

                    <TextView
                        android:id="@+id/swipeRightApp"
                        style="@style/SettingsRowValue"
                        android:maxWidth="150dp"
                        tools:text="@string/phone" />
                </LinearLayout>

                <!-- A long press opens the accessibility settings -->
                <LinearLayout
                    android:id="@+id/toggleLockRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/double_tap_to_lock_screen" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/toggleLockSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Home button for recents feature disabled
                <LinearLayout
                    android:id="@+id/homeButtonRecentsRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/home_button_show_recents" />

                    <app.olauncher.ui.SettingSwitch
                        android:id="@+id/homeButtonRecentsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                -->
            </LinearLayout>

            <!-- Breathing pause -->
            <TextView
                style="@style/SettingsSection"
                android:text="@string/breathing_pause" />

            <LinearLayout style="@style/SettingsGroup">

                <LinearLayout
                    android:id="@+id/ankiDeckRow"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/anki_deck" />

                    <TextView
                        android:id="@+id/ankiDeck"
                        style="@style/SettingsRowValue"
                        android:maxWidth="150dp"
                        android:text="@string/off" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ankiCardCountLayout"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/anki_cards" />

                    <TextView
                        android:id="@+id/ankiCardCount"
                        style="@style/SettingsRowValue"
                        tools:text="2" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
