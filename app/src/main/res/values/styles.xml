<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Shared by the light theme below and the dark one in values-night -->
    <style name="Base.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges
        </item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:colorEdgeEffect">@android:color/transparent</item>

        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <item name="colorPrimaryDark">@android:color/darker_gray</item>

        <item name="mainFontFamily">@font/geist_regular</item>

        <!-- Popup menus and dialogs used by settings -->
        <item name="popupMenuStyle">@style/OlPopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/OlPopupMenuText</item>
        <item name="textAppearanceSmallPopupMenu">@style/OlPopupMenuText</item>
        <item name="alertDialogTheme">@style/OlAlertDialog</item>

    </style>

    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="colorPrimary">@color/ink</item>
        <item name="colorAccent">@color/ink</item>

        <item name="primaryColor">@color/ink</item>
        <item name="primaryInverseColor">@color/white</item>
        <item name="primaryColorTrans50">@color/inkTrans50</item>
        <item name="primaryColorTrans80">@color/inkTrans80</item>

        <item name="textMetaColor">@color/lightTextMeta</item>
        <item name="textValueColor">@color/lightTextValue</item>
        <item name="textBodyColor">@color/lightTextBody</item>
        <item name="textMutedColor">@color/lightTextMuted</item>
        <item name="textSecondaryColor">@color/lightTextSecondary</item>
        <item name="gestureHintColor">@color/lightGestureHint</item>
        <item name="textLabelColor">@color/lightTextLabel</item>
        <item name="textFaintColor">@color/lightTextFaint</item>
        <item name="textHintColor">@color/lightTextHint</item>

        <item name="dividerColor">@color/lightDivider</item>
        <item name="searchLineColor">@color/lightSearchLine</item>
        <item name="searchLineActiveColor">@color/lightSearchLineActive</item>
        <item name="chipStrokeColor">@color/lightChipStroke</item>
        <item name="outlineColor">@color/lightOutline</item>
        <item name="cardColor">@color/lightCard</item>
        <item name="surfaceColor">@color/lightSurface</item>
        <item name="settingsBackgroundColor">@color/lightSettingsBackground</item>
        <item name="drawerOverlayColor">@color/lightDrawerOverlay</item>

        <item name="switchTrackOffColor">@color/lightSwitchTrackOff</item>
        <item name="switchThumbOffColor">@color/lightSwitchThumbOff</item>
    </style>

    <!-- Applied over AppTheme when bold font is enabled -->
    <style name="BoldFontOverlay">
        <item name="mainFontFamily">@font/geist_medium</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="AppSearchText" parent="Widget.AppCompat.SearchView">
        <item name="android:maxLength">200</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:editTextColor">?attr/primaryColor</item>
        <item name="android:textColorHint">?attr/textHintColor</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:inputType">textCapSentences|textNoSuggestions</item>
        <item name="android:cursorVisible">false</item>
    </style>

    <style name="TextDefault" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@drawable/text_colors_default</item>
        <item name="android:textColorHint">?attr/primaryColorTrans80</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Apps on the home screen -->
    <style name="TextLarge" parent="TextDefault">
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- "Settings", "Breathing pause" -->
    <style name="TextTitle" parent="TextDefault">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/primaryColor</item>
    </style>

    <!-- App list, dialog titles -->
    <style name="TextDrawer" parent="TextDefault">
        <item name="android:textSize">@dimen/drawer_text</item>
    </style>

    <!-- Settings rows, breathing pause message -->
    <style name="TextSmall" parent="TextDefault">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Data, values, labels and actions: IBM Plex Mono in capitals -->
    <style name="TextMono" parent="TextDefault">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/textMetaColor</item>
    </style>

    <!-- Section titles and eyebrows -->
    <style name="TextMonoLabel" parent="TextMono">
        <item name="android:fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/textLabelColor</item>
    </style>

    <!-- Values on the right of a settings row -->
    <style name="TextMonoValue" parent="TextMono">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/textValueColor</item>
    </style>

    <!-- Small hints, letters and counters -->
    <style name="TextMonoSmall" parent="TextMono">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Rounded outline actions in the app list's long press menu -->
    <style name="Chip" parent="TextMonoSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">?attr/primaryColor</item>
    </style>

    <!-- Settings: a section title, a section of rows with dividers between them, one row -->
    <style name="SettingsSection" parent="TextMonoLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:divider">@drawable/divider</item>
        <item name="android:orientation">vertical</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="SettingsRowLabel" parent="TextSmall">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/primaryColor</item>
    </style>

    <style name="SettingsRowValue" parent="TextMonoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Popup menu anchored to a settings row -->
    <style name="OlPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="OlPopupMenu.NoAnimation">
        <item name="android:popupAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <style name="OlPopupMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
    </style>

    <!-- Alert dialogs: the window only; content comes from layout/dialog_base.xml -->
    <style name="OlAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/OlDialogAnimation</item>
    </style>

    <style name="OlDialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="OlAlertDialog.NoAnimation">
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <!-- Applied over AppTheme on e-ink displays or when system animations are off -->
    <style name="NoAnimationOverlay">
        <item name="popupMenuStyle">@style/OlPopupMenu.NoAnimation</item>
        <item name="alertDialogTheme">@style/OlAlertDialog.NoAnimation</item>
    </style>

    <style name="NoWindowAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!-- Text actions, e.g. "Close" in the breathing pause -->
    <style name="TextButton" parent="TextMono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">?attr/textValueColor</item>
    </style>

    <!-- Main action as an outlined pill, e.g. "Open" in the breathing pause -->
    <style name="OutlineButton" parent="TextMono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_outline_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textColor">?attr/primaryColor</item>
    </style>

    <!-- One of the four answer buttons under an Anki card: the answer, the next interval below -->
    <style name="AnkiAnswerButton" parent="TextMono">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <!-- Capitals are set in code: the interval below the answer keeps its smaller size -->
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">?attr/primaryColor</item>
    </style>

    <!-- Full screen breathing pause: an opaque plain background instead of the wallpaper -->
    <style name="BreathingPauseTheme" parent="AppTheme">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">?attr/primaryInverseColor</item>
    </style>

</resources>
